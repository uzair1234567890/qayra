---
interface Props {
  value: number;
  count?: number;
  class?: string;
}

const { value, count, class: className = '' } = Astro.props;

const full = Math.floor(value);
const half = value - full >= 0.5;
---

<div
  aria-label={`${value} out of 5 stars`}
  class:list={['text-champagne inline-flex items-center gap-1 text-xs', className]}
>
  {
    Array.from({ length: 5 }).map((_, i) => (
      <span>{i < full ? '★' : i === full && half ? '⯨' : '☆'}</span>
    ))
  }
  {count !== undefined && <span class="text-navy/60 ml-1">({count})</span>}
</div>
