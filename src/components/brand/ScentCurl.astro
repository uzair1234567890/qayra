---
interface Props {
  class?: string;
  size?: number;
  stroke?: string;
  strokeWidth?: number;
  animated?: boolean;
}
const {
  class: className = '',
  size = 42,
  stroke = 'currentColor',
  strokeWidth = 1.4,
  animated = false,
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 42 24"
  width={size}
  height={(size * 24) / 42}
  fill="none"
  class:list={[className, animated && 'animate-logo-breathe']}
  aria-hidden="true"
>
  <path
    d="M2 22 C 8 14, 12 10, 16 14 C 20 18, 22 6, 26 8 C 30 10, 34 2, 40 6"
    stroke={stroke}
    stroke-width={strokeWidth}
    stroke-linecap="round"></path>
</svg>
