---
import { getSession } from '../../lib/auth/session';
import { getCartLineCount } from '../../lib/cart';
const session = await getSession(Astro.request, Astro.cookies);
const path = Astro.url.pathname;
const bagCount = await getCartLineCount(Astro.request, Astro.cookies, Astro.locals.cartToken);
---

<header class="bg-cream/90 border-navy/10 sticky top-0 z-30 border-b backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" data-no-loading class="font-display text-navy text-2xl tracking-tight"
      ><span class="lowercase">qayra</span><span class="text-champagne">.</span></a
    >
    <nav aria-label="Main navigation" class="text-navy/80 hidden gap-8 text-xs tracking-widest uppercase md:flex">
      <a
        href="/products"
        aria-current={path.startsWith('/product') ? 'page' : undefined}
        class:list={[path.startsWith('/product') && 'text-navy underline underline-offset-4']}
        >Products</a
      >
      <a
        href="/bundles/starter-set"
        aria-current={path.startsWith('/bundles') ? 'page' : undefined}
        class:list={[path.startsWith('/bundles') && 'text-navy underline underline-offset-4']}
        >Bundles</a
      >
      <a
        href="/story"
        aria-current={path === '/story' ? 'page' : undefined}
        class:list={[path === '/story' && 'text-navy underline underline-offset-4']}
        >Story</a
      >
    </nav>
    <div class="flex items-center gap-4 text-xs tracking-widest uppercase">
      {
        session ? (
          <a href="/account" class="text-navy/80 hover:text-navy">
            Account
          </a>
        ) : (
          <a href="/auth/sign-in" class="text-navy/80 hover:text-navy">
            Sign in
          </a>
        )
      }
      <a href="/cart" class="text-navy font-medium">Cart (<span data-bag-count>{bagCount}</span>)</a>
    </div>
  </div>
</header>
