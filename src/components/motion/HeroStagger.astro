---
// No props needed for v1 — fixed 3-child stagger
---
<div class="hero-stagger">
  <slot />
</div>
<style>
  .hero-stagger > :nth-child(1) {
    animation: fade-up-soft 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-stagger > :nth-child(2) {
    animation: fade-up-soft 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
  }
  .hero-stagger > :nth-child(3) {
    animation: fade-up-soft 600ms cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-stagger > * {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>
