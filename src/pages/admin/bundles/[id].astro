---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DangerZone from '../../../components/admin/DangerZone.astro';
import ImageUploadField from '../../../components/admin/ImageUploadField.astro';
import { requireRole } from '../../../lib/auth/session';
import { getBundle } from '../../../lib/admin/bundles';
import { listScents } from '../../../lib/admin/scents';
import { formatINR } from '../../../lib/format';

const result = await requireRole(Astro as any, 'admin');
if (result instanceof Response) return result;
const bundle = await getBundle(Astro.params.id!);
if (!bundle) return Astro.redirect('/admin/bundles', 302);
const scents = await listScents();
const existingItems = (bundle.bundle_items as { scent_id: string; quantity: number }[]) ?? [];
const itemMap = Object.fromEntries(existingItems.map((i) => [i.scent_id, i.quantity]));
const info = Astro.url.searchParams.get('info');
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title={`Edit: ${bundle.name}`}>
  {info && <p class="mb-4 rounded border border-green-200 bg-green-50 p-3 text-sm text-[#0A8A00]">{info}</p>}
  {error && <p class="mb-4 rounded border border-red-200 bg-red-50 p-3 text-sm text-[#C44]">{error}</p>}
  <form action="/api/admin/bundle-update" method="post" class="max-w-lg space-y-4">
    <input type="hidden" name="id" value={bundle.id} />
    <div><label class="mb-1 block text-xs font-medium text-[#444]">Name</label>
      <input name="name" required value={bundle.name} class="w-full rounded border border-[#DDDDD8] px-3 py-2 text-sm" /></div>
    <div><label class="mb-1 block text-xs font-medium text-[#444]">Slug</label>
      <input name="slug" required pattern="[a-z0-9-]+" value={bundle.slug} class="w-full rounded border border-[#DDDDD8] px-3 py-2 text-sm font-mono" /></div>
    <div><label class="mb-1 block text-xs font-medium text-[#444]">Description</label>
      <textarea name="description" rows="3" class="w-full rounded border border-[#DDDDD8] px-3 py-2 text-sm">{bundle.description ?? ''}</textarea></div>
    <div><label class="mb-1 block text-xs font-medium text-[#444]">Price (&#8377;)</label>
      <input name="price_rupees" type="number" required min="1" value={Math.round(bundle.price / 100)} class="w-full rounded border border-[#DDDDD8] px-3 py-2 text-sm font-mono" /></div>
    <ImageUploadField mode="single" max={1} kind="bundle" initial={(bundle.image_urls ?? []).slice(0, 1)} />
    <ImageUploadField mode="multi" max={5} kind="bundle" initial={(bundle.image_urls ?? []).slice(1, 6)} />
    <div><label class="mb-1 block text-xs font-medium text-[#444]">Status</label>
      <select name="status" class="w-full rounded border border-[#DDDDD8] px-3 py-2 text-sm">
        {(['draft', 'active', 'archived'] as const).map((s) => (
          <option value={s} selected={bundle.status === s}>{s}</option>
        ))}
      </select></div>
    <fieldset class="rounded border border-[#DDDDD8] p-3">
      <legend class="px-1 text-xs font-medium text-[#444]">Scents</legend>
      {scents.map((s) => (
        <label class="flex items-center gap-3 py-1 text-sm">
          <input type="checkbox" name={`scent_${s.id}`} value="1" checked={s.id in itemMap} />
          <span class="flex-1">{s.name}</span>
          <input type="number" name={`qty_${s.id}`} min="1" value={itemMap[s.id] ?? 1} class="w-16 rounded border border-[#DDDDD8] px-2 py-0.5 text-xs font-mono" />
        </label>
      ))}
    </fieldset>
    <button type="submit" class="rounded bg-[#1A1A1A] px-5 py-2 text-sm text-white">Save</button>
  </form>

  <div class="mt-12">
    <DangerZone>
      <form action="/api/admin/bundle-delete" method="post">
        <input type="hidden" name="id" value={bundle.id} />
        <button type="submit" class="rounded border border-[#C44] px-4 py-2 text-xs text-[#C44]"
          onclick="return confirm('Delete this bundle?')">
          Delete bundle
        </button>
      </form>
    </DangerZone>
  </div>
</AdminLayout>
