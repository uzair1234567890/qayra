---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusPill from '../../../components/admin/StatusPill.astro';
import { requireRole } from '../../../lib/auth/session';
import { getOrder } from '../../../lib/admin/orders';
import { formatINR } from '../../../lib/format';

const result = await requireRole(Astro as any, 'admin');
if (result instanceof Response) return result;

const order = await getOrder(Astro.params.code!);
if (!order) return Astro.redirect('/admin/orders', 302);

const info = Astro.url.searchParams.get('info');
const error = Astro.url.searchParams.get('error');

const profile = order.profile as any;
const items = (order.items ?? []) as any[];
const history = ((order.history ?? []) as any[]).sort(
  (a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
);
const addr = order.address_snapshot as any;

const CANCELLABLE = ['pending', 'paid'];
const canCancel = CANCELLABLE.includes(order.status);
---

<AdminLayout title={`Order ${order.code}`}>
  <div class="mb-4 flex items-center gap-2">
    <a href="/admin/orders" class="text-xs text-[#0066CC]">&larr; All orders</a>
    <span class="text-xs text-[#888]">/</span>
    <span class="font-mono text-xs font-medium">{order.code}</span>
  </div>

  {info && (
    <p class="mb-4 rounded border border-green-200 bg-green-50 p-3 text-sm text-[#0A8A00]">{info}</p>
  )}
  {error && (
    <p class="mb-4 rounded border border-red-200 bg-red-50 p-3 text-sm text-[#C44]">{error}</p>
  )}

  <!-- KPI row -->
  <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4">
    <div class="rounded border border-[#EAEAEA] bg-white p-4">
      <p class="text-[9px] uppercase tracking-widest text-[#888]">Total</p>
      <p class="mt-1 font-mono text-xl font-semibold">{formatINR(order.total)}</p>
    </div>
    <div class="rounded border border-[#EAEAEA] bg-white p-4">
      <p class="text-[9px] uppercase tracking-widest text-[#888]">Payment</p>
      <p class="mt-1 text-sm font-medium capitalize">{order.payment_method} · {order.payment_status}</p>
    </div>
    <div class="rounded border border-[#EAEAEA] bg-white p-4">
      <p class="text-[9px] uppercase tracking-widest text-[#888]">Status</p>
      <p class="mt-1"><StatusPill value={order.status} /></p>
    </div>
    <div class="rounded border border-[#EAEAEA] bg-white p-4">
      <p class="text-[9px] uppercase tracking-widest text-[#888]">Date</p>
      <p class="mt-1 text-sm">
        {new Date(order.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })}
      </p>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <!-- Items -->
    <div class="rounded border border-[#EAEAEA] bg-white p-4">
      <h3 class="mb-3 text-sm font-semibold">Items</h3>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-[10px] uppercase tracking-widest text-[#888]">
            <th class="py-1 text-left">Item</th>
            <th class="text-right">Qty</th>
            <th class="text-right">Price</th>
          </tr>
        </thead>
        <tbody>
          {items.map((it) => (
            <tr class="border-t border-[#F4F4F4]">
              <td class="py-1.5">{it.name_snapshot}</td>
              <td class="text-right">{it.quantity}</td>
              <td class="text-right font-mono">{formatINR(it.price_snapshot * it.quantity)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="mt-3 space-y-1 border-t border-[#F4F4F4] pt-3 text-xs text-[#666]">
        <div class="flex justify-between">
          <span>Subtotal</span>
          <span class="font-mono">{formatINR(order.subtotal)}</span>
        </div>
        {order.discount_total > 0 && (
          <div class="flex justify-between">
            <span>Discount</span>
            <span class="font-mono text-[#0A8A00]">&minus;{formatINR(order.discount_total)}</span>
          </div>
        )}
        <div class="flex justify-between">
          <span>Shipping</span>
          <span class="font-mono">{formatINR(order.shipping_total)}</span>
        </div>
        {order.cod_surcharge > 0 && (
          <div class="flex justify-between">
            <span>COD fee</span>
            <span class="font-mono">{formatINR(order.cod_surcharge)}</span>
          </div>
        )}
        <div class="flex justify-between border-t border-[#F4F4F4] pt-1 font-semibold">
          <span>Total</span>
          <span class="font-mono">{formatINR(order.total)}</span>
        </div>
      </div>
    </div>

    <!-- Right column: customer + address -->
    <div class="space-y-4">
      <div class="rounded border border-[#EAEAEA] bg-white p-4">
        <h3 class="mb-2 text-sm font-semibold">Customer</h3>
        <p class="text-sm">{profile?.full_name ?? '—'}</p>
        <p class="text-xs text-[#666]">{profile?.email ?? '—'}</p>
        {profile?.phone && (
          <p class="text-xs text-[#666]">{profile.phone}</p>
        )}
        {profile?.id && (
          <a href={`/admin/customers/${profile.id}`} class="mt-1 block text-xs text-[#0066CC]">
            View customer &rarr;
          </a>
        )}
      </div>

      {addr && (
        <div class="rounded border border-[#EAEAEA] bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold">Ship to</h3>
          <p class="text-sm">{addr.name}</p>
          <p class="text-xs text-[#666]">{addr.line1}{addr.line2 ? `, ${addr.line2}` : ''}</p>
          <p class="text-xs text-[#666]">{addr.city}, {addr.state} {addr.pincode}</p>
          {addr.phone && <p class="text-xs text-[#666]">{addr.phone}</p>}
        </div>
      )}

      {order.razorpay_order_id && (
        <div class="rounded border border-[#EAEAEA] bg-white p-4">
          <h3 class="mb-2 text-sm font-semibold">Payment IDs</h3>
          <p class="text-[10px] text-[#888]">Razorpay order</p>
          <p class="font-mono text-xs">{order.razorpay_order_id}</p>
          {order.razorpay_payment_id && (
            <>
              <p class="mt-2 text-[10px] text-[#888]">Payment</p>
              <p class="font-mono text-xs">{order.razorpay_payment_id}</p>
            </>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Status history -->
  <div class="mt-4 rounded border border-[#EAEAEA] bg-white p-4">
    <h3 class="mb-3 text-sm font-semibold">Status history</h3>
    {history.length === 0 ? (
      <p class="text-xs text-[#888]">No history yet.</p>
    ) : (
      <ol class="space-y-2">
        {history.map((h) => (
          <li class="flex flex-wrap items-start gap-3 text-xs">
            <span class="w-40 shrink-0 text-[#888]">
              {new Date(h.created_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })}
            </span>
            <StatusPill value={h.status} />
            {h.note && <span class="text-[#444]">{h.note}</span>}
          </li>
        ))}
      </ol>
    )}
  </div>

  <!-- Add note -->
  <div class="mt-4 rounded border border-[#EAEAEA] bg-white p-4">
    <h3 class="mb-3 text-sm font-semibold">Add internal note</h3>
    <form action="/api/admin/order-add-note" method="post" class="flex gap-2">
      <input type="hidden" name="order_id" value={order.id} />
      <input
        name="note"
        required
        maxlength="500"
        placeholder="Internal note…"
        class="flex-1 rounded border border-[#DDDDD8] px-3 py-2 text-sm"
      />
      <button type="submit" class="rounded bg-[#1A1A1A] px-4 py-2 text-sm text-white">
        Add
      </button>
    </form>
  </div>

  <!-- Cancel -->
  {canCancel && (
    <div class="mt-4 rounded border border-[#EAEAEA] bg-white p-4">
      <h3 class="mb-2 text-sm font-semibold">Cancel order</h3>
      <p class="mb-3 text-xs text-[#666]">
        This cannot be undone. Refund processing is handled separately.
      </p>
      <form action="/api/admin/order-cancel" method="post">
        <input type="hidden" name="order_id" value={order.id} />
        <button
          type="submit"
          class="rounded border border-[#C44] px-4 py-1.5 text-xs text-[#C44] hover:bg-[#C44] hover:text-white"
          onclick="return confirm('Cancel this order? This cannot be undone.')"
        >
          Cancel order
        </button>
      </form>
    </div>
  )}
</AdminLayout>
